# ── JWT & security ─────────────────────────────────────
SECRET_KEY=pmfby_secret_key_super_secure_ai_analytics_2026_jwt_token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 h

# ── MySQL connection (optional) ───────────────────────
# If you have a MySQL server, set these; otherwise leave them blank
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=pmfby_crop_db

# ── Override full DB URL (optional) ─────────────────────
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/pmfby_crop_db
# –‑ leave commented to let the app fall back to SQLite (pmfby_crop.db)

# ── External services (add your real keys) ───────────────
# OpenWeatherMap API key – required for weather integration
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_KEY

# LLM provider key (if you use the chatbot)
LLM_API_KEY=YOUR_LLM_KEY

# SMTP (email) credentials – used for notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password

# Twilio (SMS) credentials – used for SMS alerts
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_FROM_NUMBER=+1234567890